# Copy this file to ".env" and change the values. The real ".env" is ignored by Git.

# Secret used to sign login tokens (JWT). Use a long random string (32+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# Server port
PORT=3000

# How long a login session lasts, in hours
SESSION_HOURS=2

# Show demo accounts on the login page (always off when NODE_ENV=production)
SHOW_DEMO_ACCOUNTS=true
